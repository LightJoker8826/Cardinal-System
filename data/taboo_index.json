  "safe_zones": [
    {"name": "Town of Beginnings", "x_min": 0, "x_max": 2, "y_min": 0, "y_max": 2},
    {"name": "Floor Sanctuary", "x_min": 8, "x_max": 9, "y_min": 8, "y_max": 9}
  ],
  "immortal_objects": ["Teleport Gate", "Town Wall", "Quest Giver"]
}
