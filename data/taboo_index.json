{
  "_comment": "The Taboo Index — Cardinal's law system. The Sub-Process enforces every rule here on every mutation; the game enforces zone laws at runtime.",
  "version": 1,
  "item_laws": {
    "damage": {"min": 0, "max": 500},
    "crit_chance": {"min": 0.0, "max": 0.75},
    "crit_mult": {"min": 1.0, "max": 5.0},
    "value": {"min": 0, "max": 100000},
    "heal": {"min": 0, "max": 1000}
  },
  "enemy_laws": {
    "damage": {"min": 1, "max": 300},
    "hp": {"min": 1, "max": 5000},
    "reward_gold": {"min": 0, "max": 2000},
    "attack_window_min_s": 0.15
  },
  "player_laws": {
    "max_level": 100,
    "max_gold": 10000000,
    "max_hp": 9999
  },
  "patch_laws": {
    "max_delta_pct_per_cycle": 0.08,
    "anomaly_win_rate": 0.95,
    "anomaly_stat_sigma": 4.0,
