# ============================================================================
# CARDINAL SYSTEM — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# Every credential-dependent module degrades gracefully when its values are
# missing (except CARDINAL_API_TOKEN — the REST API refuses to serve without it).
# ============================================================================

# --- L3 Evolver (Anthropic / Fable 5) ---------------------------------------
# Set this in your .env file or shell environment before running any module
# that escalates to Tier 3. Without it, Cardinal runs on the deterministic
# L2 LocalRuleProvider (or the MockProvider, see CARDINAL_USE_MOCK).
ANTHROPIC_API_KEY=
# Model id used for all L3 calls. Never hardcoded anywhere in the codebase.
CARDINAL_MODEL=claude-fable-5

# --- Cost safety (non-negotiable) -------------------------------------------
# Hard daily API spend limit in USD. At 80% Cardinal warns (Discord) and
# switches to L2-only; at 100% all L3 calls are locked out until midnight.
MAX_DAILY_SPEND_USD=5.00
# Pricing per million tokens (defaults match Fable 5 list pricing).
CARDINAL_PRICE_INPUT_PER_MTOK=10.0
CARDINAL_PRICE_OUTPUT_PER_MTOK=50.0
CARDINAL_PRICE_CACHE_READ_PER_MTOK=1.0

# --- Mock provider (zero-token end-to-end testing) --------------------------
# When ANTHROPIC_API_KEY is absent AND this is true, the deterministic
# MockProvider (schema-exact JSON) is used instead of the L2 rule provider.
CARDINAL_USE_MOCK=false

# --- Ghost Protocol (verbosity mask) ----------------------------------------
# 0 = Ghost (silent; only critical alerts), 1 = Admin (operational), 2 = Debug
CARDINAL_VERBOSITY=1

# --- Dashboard ----------------------------------------------------------------
CARDINAL_DASHBOARD_PORT=8000

# --- REST API (engine-agnostic HTTP front door) ------------------------------
# REQUIRED for the API server. Requests without this bearer token get 401.
# The API refuses to serve at all if this is unset.
CARDINAL_API_TOKEN=
CARDINAL_API_PORT=8001

# --- Discord notifications ----------------------------------------------------
# Webhook URL for Cardinal event embeds. Fail-silent if unset.
DISCORD_WEBHOOK_URL=

# --- Reddit community sentiment (Async PRAW) ----------------------------------
# Fail-silent if unset.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=cardinal-system/0.1 (sentiment reader)
# Comma-separated subreddits to monitor.
CARDINAL_SUBREDDITS=gamedev,roguelikes
# Sentiment check interval in hours.
CARDINAL_SENTIMENT_INTERVAL_HOURS=6

# --- Biometrics ----------------------------------------------------------------
CARDINAL_BIOMETRIC_PORT=8765

# --- MHCP (Yui) -----------------------------------------------------------------
# Lore flag: Kayaba revoked Yui's interaction permission at launch.
# We default to true so the counseling layer may act.
MHCP_INTERACTION_PERMITTED=true
